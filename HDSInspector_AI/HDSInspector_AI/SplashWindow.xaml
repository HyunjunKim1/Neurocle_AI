<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDSInspector_AI"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls" x:Class="HDSInspector_AI.SplashWindow"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        WindowStyle="None"
        Title="SplashWindow" Height="400" Width="700" Loaded="Window_Loaded">

    <Window.Resources>
        <Style TargetType="{x:Type Button}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </Window.Resources>

    <Window.Background>
        <SolidColorBrush Color="#242121">
        </SolidColorBrush>
    </Window.Background>

    <Border BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1" />
        </Border.Effect>
        <Border Padding="8">
            <Grid x:Name="GridSplash">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2.5*"/>
                    <RowDefinition Height=".7*"/>
                </Grid.RowDefinitions>
                <Image Source="/HDSInspector_AI;component/Resources/Haesung_Logo_white.png"
                        Grid.Row="0" Grid.Column="0" Stretch="Fill" Width="250" Height="85"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <Image Source="/HDSInspector_AI;component/Resources/AVI.png"
                        Grid.Row="1" Grid.Column="0" Stretch="Fill" Width="250" Height="210"
                        RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="LF AVI AI Inspector" FontWeight="Bold" FontSize="30" Margin="140,0,-8,0" Foreground="White"/>
                <TextBlock Grid.Column="1" Name="tbl_Version" HorizontalAlignment="Left" Margin="214,0,0,0" TextWrapping="Wrap" Foreground="White" Text="" VerticalAlignment="Center" Width="200" TextAlignment="Right"/>
                <GroupBox Grid.Column="1" Header="Program Loading..." Grid.Row="1" FontSize="20" Name="gBox_Status">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*"/>
                            <ColumnDefinition Width="1*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height=".3*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="1*"/>
                        </Grid.RowDefinitions>
                        <Image Grid.Row="1" Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Name="iBox_Init"
                                Source="/HDSInspector_AI;component/Resources/LED_RED.png"
                                RenderOptions.BitmapScalingMode="HighQuality" Margin="20,13,0,12"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Width="150" Height="20" HorizontalAlignment="Left" Text="Load Initial Files" 
                                FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" Margin="45,0,0,5" FontSize="16" Grid.ColumnSpan="2"/>
                        <Image Grid.Row="2" Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Name="iBox_Database"
                                Source="/HDSInspector_AI;component/Resources/LED_RED.png"
                                RenderOptions.BitmapScalingMode="HighQuality" Margin="20,12,0,12"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Width="150" Height="20" HorizontalAlignment="Left" Text="Server Open" 
                                FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" Margin="45,0,0,5" FontSize="16" Grid.ColumnSpan="2"/>
                        <Image Grid.Row="3" Grid.Column="0" Width="20" Height="20" HorizontalAlignment="Left" Name="iBox_Illuminator"
                                Source="/HDSInspector_AI;component/Resources/LED_RED.png"
                                RenderOptions.BitmapScalingMode="HighQuality" Margin="20,12,0,13"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Width="150" Height="20" HorizontalAlignment="Left" Text="Check Cam Type" 
                                FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" Margin="45,0,0,5" FontSize="16" Grid.ColumnSpan="2"/>
                        <Image Grid.Row="1" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Left" Name="iBox_Alarmlist"
                                Source="/HDSInspector_AI;component/Resources/LED_RED.png"
                                RenderOptions.BitmapScalingMode="HighQuality" Margin="24,12,0,13"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Width="150" Height="20" HorizontalAlignment="Left" Text="Load Alarm List" 
                                FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" Margin="45,0,0,5" FontSize="16"/>
                        <Image Grid.Row="2" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Left" Name="iBox_Camera"
                                Source="/HDSInspector_AI;component/Resources/LED_RED.png"
                                RenderOptions.BitmapScalingMode="HighQuality" Margin="24,12,0,12"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Width="150" Height="20" HorizontalAlignment="Left" Text="Connect Grabber" 
                                FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" Margin="45,0,0,5" FontSize="16"/>
                        <Image Grid.Row="3" Grid.Column="2" Width="20" Height="20" HorizontalAlignment="Left" Name="iBox_Vision"
                                Source="/HDSInspector_AI;component/Resources/LED_RED.png"
                                RenderOptions.BitmapScalingMode="HighQuality" Margin="24,12,0,13"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Width="150" Height="20" HorizontalAlignment="Left" Text="Check H/W Devices" 
                                FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" Margin="53,0,0,5" FontSize="16"/>
                    </Grid>
                </GroupBox>
                <Button Grid.Column="1" HorizontalAlignment="Left" Margin="260,5,0,0" Grid.Row="2" VerticalAlignment="Top" 
                        Name="btn_Close" Cursor="Hand" Height="49" Width="141" />

            </Grid>
        </Border>
    </Border>
</Window>
