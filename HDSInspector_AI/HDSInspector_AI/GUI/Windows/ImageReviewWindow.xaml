<Window x:Class="HDSInspector_AI.GUI.Windows.ImageReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:toolkit="http://schemas.xceed.com/wpf/xaml/toolkit"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDSInspector_AI.GUI.Windows"
        xmlns:common="clr-namespace:Common;assembly=Common"
        xmlns:myCtrl="clr-namespace:HDSInspector_AI.GUI.UserControls.ImageReivew"
        xmlns:busyIndicator="https://github.com/Peoky/BusyIndicator"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen" Closing="ReviewWindow_Closing"
        Title="ImageReivewWindow" Height="1010" Width="1300" x:Name="ReviewWindow" Loaded="ReviewWindow_Loaded">
    <Window.Background>
        <SolidColorBrush Color="#242121"/>
    </Window.Background>
    <Window.Resources>
        <common:ColorToBrushConverter x:Key="colorToBrushConverter"/>
        <common:DoubleToDecimalConverter x:Key="doubleToDecimalconverter"/>
        <!-- ==================== 1. RadioButton 스타일 ==================== -->
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="GhostWhite"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid x:Name="rootGrid" SnapsToDevicePixels="True">
                            <!-- 원형 외곽선 -->
                            <Ellipse x:Name="outerCircle"
                              Width="14" Height="14"
                              Stroke="GhostWhite"
                              StrokeThickness="1.5"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Fill="Transparent"/>
                            <!-- 체크 마크 (내부 원) -->
                            <Ellipse x:Name="checkMark"
                              Width="8" Height="8"
                              Fill="#0078D7"  
                              Margin="3,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              Visibility="Collapsed"/>
                            <!-- Content (라벨 텍스트) -->
                            <ContentPresenter x:Name="contentPresenter"
                                       Margin="15,0,0,0"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       RecognizesAccessKey="True"/>
                        </Grid>

                        <!-- 상태에 따른 동작 -->
                        <ControlTemplate.Triggers>
                            <!-- 체크되었을 때 내부 원 보이기 -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="checkMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <!-- 비활성화 상태 -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="outerCircle" Property="Stroke" Value="#606060"/>
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                            <!-- 마우스 오버 효과 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="outerCircle" Property="Stroke" Value="#00BFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ==================== 2. Slider 스타일 ==================== -->
        <Style TargetType="Slider">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid x:Name="grid">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto" MinHeight="{TemplateBinding MinHeight}"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- TickBar 위 (라벨용, 비활성화) -->
                            <TickBar x:Name="TopTick" 
                                 Height="4" 
                                 Fill="{TemplateBinding Foreground}"
                                 Placement="Top"
                                 Grid.Row="0"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>

                            <!-- 슬라이더 본체 -->
                            <Border x:Name="TrackBackground" 
                                Grid.Row="1" 
                                Height="4" 
                                Background="#3C3C3C" 
                                Margin="0" 
                                VerticalAlignment="Center"
                                CornerRadius="2">
                                <Canvas Margin="-6,-2">
                                    <Rectangle x:Name="PART_SelectionRange" 
                                           Height="4" 
                                           Fill="{TemplateBinding Foreground}" 
                                           Visibility="Hidden"/>
                                </Canvas>
                            </Border>

                            <!-- Track (경로) -->
                            <Track x:Name="PART_Track" Grid.Row="1">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseRepeat" 
                                              Background="{x:Null}" 
                                              Foreground="{x:Null}" 
                                              BorderBrush="{x:Null}" 
                                              BorderThickness="0"
                                              Command="Slider.DecreaseLarge"/>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb x:Name="Thumb" 
                                       Width="14" 
                                       Height="14" 
                                       Background="{TemplateBinding Foreground}"
                                       BorderBrush="White"
                                       BorderThickness="1"
                                       RenderTransformOrigin="0.5,0.5">
                                        <Thumb.Effect>
                                            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="3" ShadowDepth="1"/>
                                        </Thumb.Effect>
                                        <Thumb.Style>
                                            <Style TargetType="{x:Type Thumb}">
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="{x:Type Thumb}">
                                                            <Ellipse Fill="{TemplateBinding Background}"
                                                                 Stroke="{TemplateBinding BorderBrush}"
                                                                 StrokeThickness="{TemplateBinding BorderThickness}"/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </Thumb.Style>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseRepeat" 
                                              Background="{x:Null}" 
                                              BorderBrush="{x:Null}" 
                                              BorderThickness="0"
                                              Command="Slider.IncreaseLarge"/>
                                </Track.IncreaseRepeatButton>
                            </Track>

                            <!-- TickBar 아래 -->
                            <TickBar x:Name="BottomTick" 
                                 Height="4" 
                                 Fill="{TemplateBinding Foreground}"
                                 Placement="Bottom"
                                 Grid.Row="2"
                                 Visibility="Collapsed"
                                 VerticalAlignment="Center"/>
                        </Grid>

                        <!-- 상태 트리거 -->
                        <ControlTemplate.Triggers>
                            <!-- 수직 슬라이더 대비 (필요 시) -->
                            <Trigger Property="Orientation" Value="Vertical">
                                <Setter TargetName="grid" Property="LayoutTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="-90"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <!-- TickBar 표시 -->
                            <Trigger Property="TickPlacement" Value="TopLeft">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="BottomRight">
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="TickPlacement" Value="Both">
                                <Setter TargetName="TopTick" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="BottomTick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 3. Button Style -->
        <Style x:Key="DarkGradientButton" TargetType="Button">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush EndPoint="0.5,1" StartPoint="0.5,0">
                        <GradientStop Color="#3A353D" Offset="0.0"/>
                        <GradientStop Color="#2D2B34" Offset="1.0"/>
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
            <Setter Property="BorderBrush" Value="#5A555D"/>
            <Setter Property="BorderThickness" Value="2.5"/>
            <Setter Property="Foreground" Value="GhostWhite"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,0,10,0"/>
            <Setter Property="HorizontalAlignment" Value="Right"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border 
                    x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Hover Effect -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <!-- Background Gradient 첫 번째 그라데이션 스톱 -->
                                            <ColorAnimation 
                                        Storyboard.TargetName="border"
                                        Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                        To="#4A444C" Duration="0:0:0.2"/>
                                            <!-- Background Gradient 두 번째 그라데이션 스톱 -->
                                            <ColorAnimation 
                                        Storyboard.TargetName="border"
                                        Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                        To="#3D3A42" Duration="0:0:0.2"/>
                                            <!-- BorderBrush 색상 애니메이션 (SolidColorBrush의 Color 프로퍼티) -->
                                            <ColorAnimation 
                                        Storyboard.TargetName="border"
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        To="#7A757D" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation 
                                        Storyboard.TargetName="border"
                                        Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[0].(GradientStop.Color)"
                                        To="#3A353D" Duration="0:0:0.2"/>
                                            <ColorAnimation 
                                        Storyboard.TargetName="border"
                                        Storyboard.TargetProperty="(Border.Background).(GradientBrush.GradientStops)[1].(GradientStop.Color)"
                                        To="#2D2B34" Duration="0:0:0.2"/>
                                            <ColorAnimation 
                                        Storyboard.TargetName="border"
                                        Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)"
                                        To="#5A555D" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!-- Pressed Effect -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <LinearGradientBrush
             x:Key="IndicatorForeground"
             MappingMode="Absolute"
             StartPoint="399.906,240.414"
             EndPoint="419.903,240.414">
            <LinearGradientBrush.GradientStops>
                <GradientStop
                 Offset="0.26"
                 Color="#0078D7" />
                <GradientStop
                 Offset="1.00"
                 Color="#FF005599" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush
         x:Key="IndicatorBackground"
         MappingMode="Absolute"
         StartPoint="489.491,230.414"
         EndPoint="509.491,230.414">
            <LinearGradientBrush.GradientStops>
                <GradientStop
                 Offset="0.00"
                 Color="#FFD8E7FD"/>
                <GradientStop
                 Offset="0.73"
                 Color="#0078D7" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <Style TargetType="{x:Type ScrollBar}">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="OverridesDefaultStyle" Value="true"/>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Vertical">
                    <Setter Property="Width" Value="18"/>
                    <Setter Property="Height" Value="Auto" />
                    <Setter Property="Template" Value="{StaticResource VerticalScrollBarWhite}" />
                </Trigger>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="18" />
                    <Setter Property="Template" Value="{StaticResource HorizontalScrollBarWhite}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type Label}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontFamily" Value="Arial"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="59*"/>
            <ColumnDefinition Width="2"/>
            <ColumnDefinition Width="25*"/>
            <ColumnDefinition Width="34*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="30"/>
            <RowDefinition/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>
        <!-- 좌측 -->
        <Border Grid.Row="0" Grid.Column="0" BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Border Padding="2.2">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#242121" Offset="0.0"/>
                            <GradientStop Color="#2A252E" Offset="0.35"/>
                            <GradientStop Color="#2D2B34" Offset="0.5"/>
                            <GradientStop Color="#262A2F" Offset="0.7"/>
                            <GradientStop Color="#1F1E22" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.5*"/>
                        <ColumnDefinition Width="6*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text=" Image File Name : " FontWeight="Bold" Foreground="GhostWhite" FontSize="14"/>
                    <TextBlock Text="Testimage.bmp" FontWeight="Bold" Foreground="GhostWhite" FontSize="14" Grid.ColumnSpan="2" Margin="128,0,167,0"/>
                    <Button x:Name="btn_Load" Grid.Column="1" Click="LoadButton_Click" Style="{StaticResource DarkGradientButton}" Margin="298,0,108,0" HorizontalAlignment="Stretch" Grid.ColumnSpan="2">Image Load</Button>
                    <Button x:Name="btn_Save" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Left" Click="SaveButton_Click" Margin="100,0,0,0" Style="{StaticResource DarkGradientButton}">Image Save</Button>
                </Grid>
            </Border>
        </Border>
        <Grid Grid.Row="1" Grid.RowSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="240"/>
            </Grid.RowDefinitions>
            <Border BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
                </Border.Effect>
                <Border Padding="2.2">
                    <Grid Margin="0,496,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition Height="0*"/>
                        </Grid.RowDefinitions>
                        <Grid.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#242121" Offset="0.0"/>
                                <GradientStop Color="#2A252E" Offset="0.35"/>
                                <GradientStop Color="#2D2B34" Offset="0.5"/>
                                <GradientStop Color="#262A2F" Offset="0.7"/>
                                <GradientStop Color="#1F1E22" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160*"/>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="109*"/>
                            <ColumnDefinition Width="52*"/>
                            <ColumnDefinition Width="160*"/>
                            <ColumnDefinition Width="0*"/>
                            <ColumnDefinition Width="160*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderThickness="1" BorderBrush="White" CornerRadius="5" Margin="11,0,0,10" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="150" Grid.ColumnSpan="3" >
                            <TextBlock Text="Erosion" FontSize="20" Foreground="AntiqueWhite" Margin="40,0,40,0" />
                        </Border>
                        <CheckBox x:Name="chkErosion" Tag="Erosion" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,0,12" IsChecked="False" Click="CheckBox_Changed" Height="20" Width="20">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Grid Width="20" Height="20">
                                        <Border x:Name="box" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="2" />
                                        <Path x:Name="check" Visibility="Collapsed" Stroke="Black" StrokeThickness="3" Data="M 4 10 L 9 15 L 17 6"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <Border BorderThickness="1" Grid.Column="4" BorderBrush="White" CornerRadius="5" Margin="0,0,0,10" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="150" >
                            <TextBlock Text="Dilation" FontSize="20" Foreground="AntiqueWhite" Margin="10,0,10,0" HorizontalAlignment="Center"/>
                        </Border>
                        <CheckBox x:Name="chkDilation" Tag="Dilation" Grid.Column="5" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,8,0,12" IsChecked="False" Click="CheckBox_Changed" Height="20" Width="20" Grid.ColumnSpan="2">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Grid Width="20" Height="20">
                                        <Border x:Name="box" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="2" />
                                        <Path x:Name="check" Visibility="Collapsed" Stroke="Black" StrokeThickness="3" Data="M 4 10 L 9 15 L 17 6"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <Border BorderThickness="1" BorderBrush="White" CornerRadius="5" Margin="11,0,0,145" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Left" Width="150" Grid.ColumnSpan="3" >
