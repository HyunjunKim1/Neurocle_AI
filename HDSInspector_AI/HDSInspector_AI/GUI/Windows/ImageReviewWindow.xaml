                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <Border BorderThickness="1" BorderBrush="White" CornerRadius="5" Margin="0,0,0,100" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="150" Grid.Column="4" >
                            <TextBlock Text="Sobel Edge" FontSize="20" Foreground="AntiqueWhite" Margin="10,0,10,0" HorizontalAlignment="Center"/>
                        </Border>
                        <CheckBox x:Name="chkSobel" Tag="Sobel" Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,102" IsChecked="False" Click="CheckBox_Changed" Height="20" Width="20">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Grid Width="20" Height="20">
                                        <Border x:Name="box" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="2" />
                                        <Path x:Name="check" Visibility="Collapsed" Stroke="Black" StrokeThickness="3" Data="M 4 10 L 9 15 L 17 6"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <Border BorderThickness="1" BorderBrush="White" CornerRadius="5" Margin="0,0,0,145" Height="25" VerticalAlignment="Bottom" HorizontalAlignment="Center" Width="150" Grid.Column="4" >
                            <TextBlock Text="Median Filter" FontSize="20" Foreground="AntiqueWhite" Margin="10,0,10,0" HorizontalAlignment="Center"/>
                        </Border>
                        <CheckBox x:Name="chkMedian" Tag="Median" Grid.Column="6" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="8,0,0,148" IsChecked="False" Click="CheckBox_Changed" Height="20" Width="20">
                            <CheckBox.Template>
                                <ControlTemplate TargetType="CheckBox">
                                    <Grid Width="20" Height="20">
                                        <Border x:Name="box" Background="White" BorderBrush="Black" BorderThickness="2" CornerRadius="2" />
                                        <Path x:Name="check" Visibility="Collapsed" Stroke="Black" StrokeThickness="3" Data="M 4 10 L 9 15 L 17 6"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </CheckBox.Template>
                        </CheckBox>
                        <TextBlock Grid.Row="0" Grid.ColumnSpan="3" Text="이미지 전처리" Foreground="White" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Top" Grid.Column="2" Margin="0,-15,0,0"/>
                        <Rectangle Grid.Row="0" Grid.ColumnSpan="7" Height="1" Fill="White" Margin="10,10,10,0" VerticalAlignment="Top"/>
                    </Grid>
                </Border>
            </Border>
            <Border Grid.Row="1" Grid.Column="0" BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
                </Border.Effect>
                <Border Padding="2.2">
                    <Grid>
                        <Grid.Background>
                            <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                                <GradientStop Color="#242121" Offset="0.0"/>
                                <GradientStop Color="#2A252E" Offset="0.35"/>
                                <GradientStop Color="#2D2B34" Offset="0.5"/>
                                <GradientStop Color="#262A2F" Offset="0.7"/>
                                <GradientStop Color="#1F1E22" Offset="1.0"/>
                            </LinearGradientBrush>
                        </Grid.Background>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="20"/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="5"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border BorderBrush="#FF919191" CornerRadius="6,6,0,0" Grid.Row="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#4A4A5A" Offset="0.0"/>
                                    <!-- 밝은 회갈색 계열 -->
                                    <GradientStop Color="#3A3A4A" Offset="0.5"/>
                                    <GradientStop Color="#2E2E3E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" FontFamily="Arial" FontWeight="Bold" Width="80" VerticalAlignment="Center" Foreground="GhostWhite" Margin="15, 0, 0, 0">ROI Histogram</TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Background="White" BorderBrush="Silver" BorderThickness="1, 1, 0, 1">
                            <myCtrl:Uc_Histogram x:Name="HistogramCtrl" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" Margin="0, 0, 10, 0" Height="200"/>
                        </Border>
                        <Border BorderBrush="#FF919191" CornerRadius="6,6,0,0" Grid.Row="0" Grid.Column="2">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1">
                                    <GradientStop Color="#4A4A5A" Offset="0.0"/>
                                    <!-- 밝은 회갈색 계열 -->
                                    <GradientStop Color="#3A3A4A" Offset="0.5"/>
                                    <GradientStop Color="#2E2E3E" Offset="1.0"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontSize="12" FontFamily="Arial" FontWeight="Bold" Width="80" VerticalAlignment="Center" Foreground="GhostWhite" Margin="15, 0, 0, 0">Line Profile</TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Grid.Row="1" Grid.Column="2" Background="White" BorderBrush="Silver" BorderThickness="1, 1, 0, 1">
                            <myCtrl:Uc_LineProfile x:Name="LineProfileCtrl" HorizontalContentAlignment="Stretch" VerticalAlignment="Top" Margin="0, 0, 10, 0" Height="200"/>
                        </Border>
                    </Grid>
                </Border>
            </Border>
        </Grid>

        <!-- 우측 -->
        <Border Grid.Row="0" Grid.Column="2" BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Border Padding="2.2">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#242121" Offset="0.0"/>
                            <GradientStop Color="#2A252E" Offset="0.35"/>
                            <GradientStop Color="#2D2B34" Offset="0.5"/>
                            <GradientStop Color="#262A2F" Offset="0.7"/>
                            <GradientStop Color="#1F1E22" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5.5*"/>
                        <ColumnDefinition Width="3*"/>
                        <ColumnDefinition Width="4*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.ColumnSpan="2"
                Margin="5,0,0,0">
                        <TextBlock Text="Scale:" FontWeight="Bold" Foreground="GhostWhite" FontSize="12"/>
                        <TextBlock Name="tbk_ScaleValue" Width="30" FontWeight="Bold" HorizontalAlignment="Right" FontSize="12" Foreground="GhostWhite"
                                Text="0.0"/>
                        <Button x:Name="btnZoomOut" Width="50" Tag="OUT" VerticalAlignment="Center" Margin="-8, 0"
		                        Style="{StaticResource NullBackgroundButtonStyle}" Cursor="Hand" ToolTip="Zoom Out">
                            <Image Source="/HDSInspector_AI;component/Resources/ZOOM_OUT.png"/>
                        </Button>
                        <Slider Name="sldrScale" Orientation="Horizontal" Margin="-5, 0"
		            Minimum="0.05" Maximum="15.0" Value="0.5" 
		            VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="0.1" 
		            Width="120" Style="{DynamicResource SimpleSlider}" ValueChanged="sldrScale_ValueChanged"/>
                        <Button x:Name="btnZoomIn" Width="50" Tag="IN" VerticalAlignment="Center" Margin="-8, 0"
		            Style="{StaticResource NullBackgroundButtonStyle}" Cursor="Hand" ToolTip="Zoom In">
                            <Image Source="/HDSInspector_AI;component/Resources/ZOOM_IN.png"/>
                        </Button>
                        <Button x:Name="btnZoomToFit" Width="50" Tag="FIT" VerticalAlignment="Center" Margin="-8, 0"
		            Style="{StaticResource NullBackgroundButtonStyle}" Cursor="Hand" ToolTip="Zoom To Fit">
                            <Image Source="/HDSInspector_AI;component/Resources/ZOOM_FIT.png"/>
                        </Button>
                        <ToggleButton Name="extract_ROI" Tag="Extract_ROI" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Margin="30, 0" FontSize="12" Foreground="GhostWhite" FontWeight="Bold" 
                            Content="제품 추출" Style="{StaticResource CustomToggleButtonStyle}" Width="83" IsChecked="False" Click="CheckBox_Changed" />
                    </StackPanel>

                    <!-- Display X & Y Coordinates -->
                    <Grid Grid.Column="1" Grid.ColumnSpan="2" Margin="120,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="45"/>
                            <ColumnDefinition Width="0.75*"/>
                            <ColumnDefinition Width="10"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="GhostWhite" FontWeight="Bold" FontSize="15" HorizontalAlignment="Right">X :</TextBlock>
                        <TextBlock Name="txtXPosition" HorizontalAlignment="Right" Foreground="GhostWhite" FontWeight="Bold" FontSize="15" Grid.Column="1">0</TextBlock>

                        <TextBlock Foreground="GhostWhite" FontWeight="Bold" FontSize="15" Grid.Column="2" HorizontalAlignment="Right">Y :</TextBlock>
                        <TextBlock Name="txtYPosition" HorizontalAlignment="Right" Foreground="GhostWhite" FontWeight="Bold" FontSize="15" Grid.Column="3">0</TextBlock>

                        <TextBlock Foreground="GhostWhite" FontWeight="Bold" FontSize="15" Grid.Column="4" HorizontalAlignment="Right">GV :</TextBlock>
                        <TextBlock Name="txtGVValue" HorizontalAlignment="Right" Foreground="GhostWhite" FontWeight="Bold" FontSize="15" Grid.Column="5">0</TextBlock>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Column="2" Grid.Row="1" BorderBrush="Black" BorderThickness="1, 0, 1, 1" Grid.ColumnSpan="2">
            <ScrollViewer x:Name="svTeaching" Background="White" HorizontalScrollBarVisibility="Visible" VerticalScrollBarVisibility="Visible" Focusable="False">
                <Grid x:Name="pnlOuter" Background="Black" >
                    <Grid x:Name="pnlInner" Background="Black" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid.LayoutTransform>
                            <ScaleTransform x:Name="imageScale" ScaleX="{Binding ElementName=sldrScale, Path=Value, Mode=OneWay}"
						ScaleY="{Binding ElementName=sldrScale, Path=Value, Mode=OneWay}"/>
                        </Grid.LayoutTransform>
                    </Grid>
                    <Canvas x:Name="cvsCross" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Line Name="VerticalLine" Stroke="Red" StrokeThickness="1" StrokeDashArray="2 2" Visibility="Collapsed" Panel.ZIndex="10" />
                        <Line Name="HorizontalLine" Stroke="Red" StrokeThickness="1" StrokeDashArray="2 2" Visibility="Collapsed" Panel.ZIndex="10" />
                    </Canvas>
                </Grid>
            </ScrollViewer>
        </Border>
        <Border Grid.Row="2" Grid.Column="2" BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8" Grid.ColumnSpan="2">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
            </Border.Effect>
            <Border Padding="2.2">
                <Grid>
                    <Grid.Background>
                        <LinearGradientBrush EndPoint="0.5,1" MappingMode="RelativeToBoundingBox" StartPoint="0.5,0">
                            <GradientStop Color="#242121" Offset="0.0"/>
                            <GradientStop Color="#2A252E" Offset="0.35"/>
                            <GradientStop Color="#2D2B34" Offset="0.5"/>
                            <GradientStop Color="#262A2F" Offset="0.7"/>
                            <GradientStop Color="#1F1E22" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="0.7*"/>
                        <ColumnDefinition Width="1.6*"/>
                        <ColumnDefinition Width="1.2*"/>
                    </Grid.ColumnDefinitions>
                    <ToggleButton Name="chkBinarization" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="12" Foreground="GhostWhite" FontWeight="Bold" 
                          Content="이진 변환" Style="{StaticResource CustomToggleButtonStyle}"/>
                    <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="0" HorizontalAlignment="Left"  VerticalAlignment="Center" Width="110">
                        <RadioButton Name="radSingleThreshold" Foreground="GhostWhite" FontSize="12" IsChecked="True" IsEnabled="{Binding ElementName=chkBinarization, Path=IsChecked, Mode=OneWay}">Single</RadioButton>
                        <RadioButton Name="radMultiThreshold"  Foreground="GhostWhite" FontSize="12" IsEnabled="{Binding ElementName=chkBinarization, Path=IsChecked, Mode=OneWay}" Margin="10,0,0,0" >Multi</RadioButton>
                    </StackPanel>
                    <Grid Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Grid.RowSpan="2" Name="pnlBinarization" IsEnabled="{Binding ElementName=chkBinarization, Path=IsChecked, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid Name="pnlSingleBinarization" Grid.RowSpan="2" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtThreshold_Name" Grid.Row="0" Grid.Column="0" Foreground="GhostWhite" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Text="임계"></TextBlock>
                            <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=txtThreshold, Path=Text, Mode=TwoWay}" Name="sldrThreshold"></Slider>
                            <toolkit:IntegerUpDown Grid.Row="0" Grid.Column="2" Height="24" Margin="0,1,5,0" Value="100" Increment="1" Minimum="0" Maximum="255" FontSize="11" Name="txtThreshold"/>
                        </Grid>
                        <Grid Name="pnlMultiBinarization" Grid.RowSpan="2" Margin="5">
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50"/>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="50"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="txtLower" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Foreground="GhostWhite" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Text="하한"></TextBlock>
                            <TextBlock x:Name="txtUpper" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Foreground="GhostWhite" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Text="상한"></TextBlock>
                            <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="{Binding ElementName=sldrUpperThreshold, Path=Maximum, Mode=OneWay}" TickFrequency="1" IsSnapToTickEnabled="True" 
                            Value="{Binding ElementName=txtLowerThreshold, Path=Text, Mode=TwoWay}" Name="sldrLowerThreshold"></Slider>
                            <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center"  Minimum="{Binding ElementName=sldrLowerThreshold, Path=Minimum, Mode=OneWay}" Maximum="255" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=txtUpperThreshold, Path=Text, Mode=TwoWay}" Name="sldrUpperThreshold"></Slider>
                            <toolkit:IntegerUpDown Grid.Row="0" Grid.Column="2" Height="24" Margin="0,1,5,26" Value="100" Increment="1" Minimum="0" FontSize="11"
                            Maximum="{Binding ElementName=txtUpperThreshold, Path=Value, Mode=OneWay}" Name="txtLowerThreshold" Grid.RowSpan="2"/>
                            <toolkit:IntegerUpDown Grid.Row="1" Grid.Column="2" Height="24" Margin="0,1,5,0" Value="200" Increment="1" Minimum="{Binding ElementName=txtLowerThreshold, Path=Value, Mode=OneWay}" FontSize="11"
                            Maximum="255" Name="txtUpperThreshold"/>
                        </Grid>
                    </Grid>
                    <Grid Grid.Row="0" Grid.Column="3" Grid.RowSpan="2" Name="pnlErosionAndDilation" IsEnabled="{Binding ElementName=chkBinarization, Path=IsChecked, Mode=OneWay}" Margin="5">
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="50"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="50"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock x:Name="txtErosion_name"   Grid.Row="0" Grid.Column="0" Foreground="GhostWhite" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Text="축소"></TextBlock>
                        <TextBlock x:Name="txtDilation_name" Grid.Row="1" Grid.Column="0" Foreground="GhostWhite" VerticalAlignment="Center" HorizontalAlignment="Center" FontWeight="Bold" FontSize="12" Text="확대"></TextBlock>
                        <Slider Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True" 
                            Value="{Binding ElementName=txtErosionIter, Path=Text, Mode=TwoWay}" Name="sldrErosionIter" />
                        <Slider Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                            Value="{Binding ElementName=txtDialtionIter, Path=Text, Mode=TwoWay}" Name="sldrDilationIter"/>
                        <toolkit:IntegerUpDown Grid.Row="0" Grid.Column="2" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Value="0" Increment="1" Minimum="0" Maximum="10" FontSize="11"
                            Name="txtErosionIter"/>
                        <toolkit:IntegerUpDown Grid.Row="1" Grid.Column="2" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Value="0" Increment="1" Minimum="0" Maximum="10" FontSize="11"
                            Name="txtDialtionIter" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
        <!-- 후순위 추가 예정 
        <busyIndicator:BusyMask Grid.Row="0" Grid.Column="0"  Width="1300" Height="980" Visibility="Visible"
            x:Name="BusyIndicator"
            BusyContent="이미지 크기에 따라 시간이 소요될 수 있습니다."
            IndicatorType="Ring"
            IsBusy="False"
            Background="#D8FFFFFF" >
        </busyIndicator:BusyMask>
        -->
    </Grid>
</Window>
