                        <CheckBox x:Name="chkCanny" Grid.Column="2" Tag="Canny" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="14,0,0,102" IsChecked="False" Click="CheckBox_Changed" Height="20" Width="20">
                            <CheckBox.Template>
