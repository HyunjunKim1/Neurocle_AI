<Window x:Class="HDSInspector_AI.GUI.Windows.ImageReivewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDSInspector_AI.GUI.Windows"
        xmlns:busyIndicator="https://github.com/Peoky/BusyIndicator"
        mc:Ignorable="d"
        Title="ImageReivewWindow" Height="1080" Width="1300">
    <Window.Resources>
        <LinearGradientBrush
    x:Key="IndicatorForeground"
    MappingMode="Absolute"
    StartPoint="399.906,240.414"
    EndPoint="419.903,240.414">
            <LinearGradientBrush.GradientStops>
                <GradientStop
            Offset="0.26"
            Color="#0078D7" />
                <GradientStop
            Offset="1.00"
            Color="#FF005599" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush
    x:Key="IndicatorBackground"
    MappingMode="Absolute"
    StartPoint="489.491,230.414"
    EndPoint="509.491,230.414">
            <LinearGradientBrush.GradientStops>
                <GradientStop
            Offset="0.00"
            Color="#FFD8E7FD"/>
                <GradientStop
            Offset="0.73"
            Color="#0078D7" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </Window.Resources>
    <Grid>
        <busyIndicator:BusyMask Width="1300" Height="1080" Visibility="Visible"
            x:Name="BusyIndicator"
            BusyContent="검사를 종료하고 있습니다. 서버 연결 상태에 따라 시간이 소요될 수 있습니다."
            IndicatorType="Ring"
            IsBusy="False"
            Background="#D8FFFFFF" Grid.ColumnSpan="3" VerticalAlignment="Bottom">
        </busyIndicator:BusyMask>
    </Grid>
</Window>
