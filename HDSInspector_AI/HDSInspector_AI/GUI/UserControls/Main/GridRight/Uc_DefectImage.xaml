<UserControl x:Class="HDSInspector_AI.GUI.UserControls.Main.GridRight.Uc_DefectImage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDSInspector_AI.GUI.UserControls.Main.GridRight"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="768" Background="#121d2f"
             Loaded="UserControl_Loaded">
    <Border BorderBrush="WhiteSmoke"
            BorderThickness="2"
            CornerRadius="8">

        <Border.Effect>
            <DropShadowEffect Color="Black"
                              Opacity="0.3"
                              BlurRadius="10"
                              ShadowDepth="1"/>
        </Border.Effect>

        <Border Padding="10">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="34"/>
                    <RowDefinition Height="44"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Grid Grid.Row="0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="DEFECT IMAGE"
                               Foreground="White"
                               FontSize="15"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Content="REFRESH"
                            Width="72"
                            Height="25"
                            Padding="5"
                            Foreground="White"
                            Background="#26364D"
                            BorderBrush="#4B607C"
                            />

                </Grid>

                <!-- Current Path -->
                <Border Grid.Row="1"
                        Background="#1A2940"
                        CornerRadius="4"
                        Padding="8,4"
                        Margin="0,2,0,6">

                    <TextBlock x:Name="tbkCurrentPath"
                               Text="작업 경로가 설정되지 않았습니다."
                               Foreground="#AAB7C8"
                               FontSize="10"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}"
                               VerticalAlignment="Center"/>

                </Border>

                <!-- Camera Status -->
                <Grid Grid.Row="2">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Background="#17263B"
                            BorderBrush="#324A68"
                            BorderThickness="1"
                            CornerRadius="6"
                            Margin="0,0,4,0"
                            Padding="10">
                        <StackPanel>
                            <TextBlock Text="TOP" Foreground="#81D4FA" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="9011" Foreground="#8495AA" FontSize="10" Margin="0,2,0,14"/>
                            <TextBlock x:Name="tbkTopStatus" Text="NO DEFECT" Foreground="#66BB6A" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="tbkTopPath" Text="" Foreground="#AAB7C8" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="#17263B" BorderBrush="#324A68" BorderThickness="1" CornerRadius="6" Margin="2,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="BOTTOM" Foreground="#81D4FA" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="9021" Foreground="#8495AA" FontSize="10" Margin="0,2,0,14"/>
                            <TextBlock x:Name="tbkBottomStatus" Text="NO DEFECT" Foreground="#66BB6A" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="tbkBottomPath" Text="" Foreground="#AAB7C8" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="#17263B" BorderBrush="#324A68" BorderThickness="1" CornerRadius="6" Margin="4,0,0,0" Padding="10">
                        <StackPanel>
                            <TextBlock Text="TRANS" Foreground="#81D4FA" FontWeight="Bold" FontSize="14"/>
                            <TextBlock Text="9031" Foreground="#8495AA" FontSize="10" Margin="0,2,0,14"/>
                            <TextBlock x:Name="tbkTransStatus" Text="NO DEFECT" Foreground="#66BB6A" FontWeight="Bold" FontSize="13"/>
                            <TextBlock x:Name="tbkTransPath" Text="" Foreground="#AAB7C8" FontSize="9" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Border>
</UserControl>
