<UserControl x:Class="HDSInspector_AI.GUI.UserControls.Main.GridRight.Uc_Result"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDSInspector_AI.GUI.UserControls.Main.GridRight"
             mc:Ignorable="d" Background="#121d2f">
    <Border BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="32"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Result" Foreground="White" FontWeight="Bold" FontSize="15" VerticalAlignment="Center"/>
                <TextBlock x:Name="tbkProductOrder" Grid.Column="1" Foreground="#B8C5D6" FontSize="11" VerticalAlignment="Center"/>
                <TextBlock x:Name="tbkStripNumber" Grid.Column="2" Foreground="#81D4FA" FontFamily="Consolas" FontWeight="Bold" VerticalAlignment="Center"/>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                
                <!-- Current Strip -->
                <Border Grid.Column="0" Background="#172438" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Current Strip" Foreground="#AAB7C8" FontWeight="Bold"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="OK" Foreground="#66BB6A"/>
                                <TextBlock x:Name="tbkStripOK" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="NG" Foreground="#EF5350"/>
                                <TextBlock x:Name="tbkStripNG" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Unknown" Foreground="#FFB74D"/>
                                <TextBlock x:Name="tbkStripUnknown" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
                
                <!-- Total -->
                <Border Grid.Column="2" Background="#172438" CornerRadius="6" Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock Text="Product / Order Total" Foreground="#AAB7C8" FontWeight="Bold"/>
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                                <TextBlock Text="OK" Foreground="#66BB6A"/>
                                <TextBlock x:Name="tbkTotalOK" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                                <TextBlock Text="NG" Foreground="#EF5350"/>
                                <TextBlock x:Name="tbkTotalNG" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                                <TextBlock Text="Unknown" Foreground="#FFb74D"/>
                                <TextBlock x:Name="tbkTotalUnknown" Text="0" Foreground="White" FontSize="26" FontWeight="Bold"/>
                            </StackPanel>

                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
