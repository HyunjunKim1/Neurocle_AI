<UserControl x:Class="HDSInspector_AI.GUI.UserControls.Main.GridRight.SubUc_InferenceImageTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDSInspector_AI.GUI.UserControls.Main.GridRight"
             mc:Ignorable="d">
    <Border Width="115" Height="115" Margin="3" Padding="3" Background="#0C1523" BorderBrush="#3A506D" BorderThickness="1" CornerRadius="5">
        <Grid>
            <Image Source="{Binding DefectImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            
            <!-- Index -->
            <Border Background="#AA000000" CornerRadius="3" Padding="3, 1" HorizontalAlignment="Left" VerticalAlignment="Top">
                <TextBlock Text="{Binding IndexText}" Foreground="White" FontSize="9"/>
            </Border>
            
            <!-- Class / Probability -->
            <Border Background="#BB000000" CornerRadius="3" Padding="4, 2" HorizontalAlignment="Stretch" VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="{Binding ClassText}" Foreground="White" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding ProbabilityText}" Foreground="#B9C7D8" FontSize="8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>
