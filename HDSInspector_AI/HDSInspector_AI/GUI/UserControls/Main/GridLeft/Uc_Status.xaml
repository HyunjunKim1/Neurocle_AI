<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDSInspector_AI.GUI.UserControls.Main.GridLeft"
             xmlns:hc="https://handyorg.github.io/handycontrol" 
             x:Class="HDSInspector_AI.GUI.UserControls.Main.GridLeft.Uc_Status"
             mc:Ignorable="d" 
             d:DesignHeight="260" d:DesignWidth="384" Background="#121d2f"
             Loaded="UserControl_Loaded" Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <!-- 왼쪽 항목 제목-->
        <Style x:Key="StatusLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#AAB7C8"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <!-- 제품, 오더번호 박스 -->
        <Style x:Key="StatusValueBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#17263B"/>
            <Setter Property="BorderBrush" Value="#405978"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="0, 2, 0, 4"/>
        </Style>
        <Style x:Key="StatusValueTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>
        <Style x:Key="RoundedGreenButton" TargetType="Button">
            <Setter Property="Background" Value="#238636"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8, 3"/>
            <Setter Property="FontSize" Value="17"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="LightGray"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="Gray"/>
                                <Setter Property="Foreground" Value="Black"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Border BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <Border Padding="10">
            <Grid x:Name="GridStatus">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="58"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <!-- Product Name -->
                <Grid Grid.Row="0" Margin="0, 0, 0, 3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="제품 이름" Style="{StaticResource StatusLabelStyle}"/>
                        <Border Grid.Column="1" Style="{StaticResource StatusValueBorderStyle}">
                            <TextBlock x:Name="tbkProductName" Text="-" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Style="{StaticResource StatusValueTextStyle}"/>
                        </Border>
                </Grid>
                
                <!-- 오더 번호 -->
                <Grid Grid.Row="1" Margin="0, 0, 0, 3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="90"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="오더 번호" Style="{StaticResource StatusLabelStyle}"/>
                    <Border Grid.Column="1" Style="{StaticResource StatusValueBorderStyle}">
                        <TextBlock x:Name="tbkOrderNumber" Text="-" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Style="{StaticResource StatusValueTextStyle}"/>
                    </Border>
                </Grid>
                
                <!-- Main S/W 연결 -->
                <Grid Grid.Row="2" Margin="0, 3, 0, 3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.8*"/>
                        <ColumnDefinition Width="55"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="95"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="tbkEquipmentNum" Text="EAV01" Grid.Column="0" FontSize="23" FontWeight="Bold" Style="{StaticResource StatusLabelStyle}" 
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Image x:Name="iBox_MainSW" Grid.Column="1" Width="38" Height="38" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Source="/HDSInspector_AI;component/Resources/CHECK_OFF.png" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Grid.Column="2" Text="Main S/W" Foreground="White" FontSize="21" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    <Button x:Name="btnMainSwConnect" Grid.Column="3" Content="Connect" Height="34" Style="{StaticResource RoundedGreenButton}"/>
                </Grid>
                <local:SubUc_StatusCtrl Grid.Row="3"/>
            </Grid>
        </Border>
    </Border>
</UserControl>

    