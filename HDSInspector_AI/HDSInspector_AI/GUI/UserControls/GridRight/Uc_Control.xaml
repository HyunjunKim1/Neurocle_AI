<UserControl x:Class="HDSInspector_AI.GUI.UserControls.GridRight.Uc_Control"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDSInspector_AI.GUI.UserControls.GridRight"
             mc:Ignorable="d" 
             d:DesignHeight="540" d:DesignWidth="768" Background="#121d2f">
    <Border BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <Border Padding="8">
            <Grid>
                <Button Content="TEST BUTTON" FontSize="40" Foreground="White" Click="Button_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Height="100" Width="450"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
