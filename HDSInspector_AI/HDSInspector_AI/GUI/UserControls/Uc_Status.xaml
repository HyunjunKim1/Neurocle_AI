<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:HDSInspector_AI.GUI.UserControls"
             xmlns:hc="https://handyorg.github.io/handycontrol" x:Class="HDSInspector_AI.GUI.UserControls.Uc_Status"
             mc:Ignorable="d" 
             d:DesignHeight="300" d:DesignWidth="384" Background="#242120">

    <Border BorderBrush="WhiteSmoke" BorderThickness="2" CornerRadius="8">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.3" BlurRadius="10" ShadowDepth="1"/>
        </Border.Effect>
        <Border Padding="8">
            <Grid x:Name="GridStatus">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="2*"/>
                </Grid.RowDefinitions>

                <Label Grid.Column="0" Grid.Row="0" Content="Product Name" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Label Grid.Column="0" Grid.Row="1" Content="Model Name" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <Label Grid.Column="0" Grid.Row="2" Content="Connection" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="18" FontWeight="Bold" Foreground="White"/>
                <local:SubUc_StatusCtrl Grid.Row="3" Grid.ColumnSpan="2"/>
            </Grid>
        </Border>
    </Border>
</UserControl>
