<Window  x:Class="HDSInspector_AI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:HDSInspector_AI"
        xmlns:busyIndicator="https://github.com/Peoky/BusyIndicator"
        mc:Ignorable="d"
        WindowStyle="ThreeDBorderWindow" WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        HorizontalAlignment="Center" VerticalAlignment="Center"
        WindowState="Maximized" Height="1080" Width="1920" Title="Haesung DS LF AVI Version 1.0.0">

    <Window.Resources>
        <LinearGradientBrush
        x:Key="IndicatorForeground"
        MappingMode="Absolute"
        StartPoint="399.906,240.414"
        EndPoint="419.903,240.414">
            <LinearGradientBrush.GradientStops>
                <GradientStop
                Offset="0.26"
                Color="#0078D7" />
                <GradientStop
                Offset="1.00"
                Color="#FF005599" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
        <LinearGradientBrush
        x:Key="IndicatorBackground"
        MappingMode="Absolute"
        StartPoint="489.491,230.414"
        EndPoint="509.491,230.414">
            <LinearGradientBrush.GradientStops>
                <GradientStop
                Offset="0.00"
                Color="#FFD8E7FD" />
                <GradientStop
                Offset="0.73"
                Color="#0078D7" />
            </LinearGradientBrush.GradientStops>
        </LinearGradientBrush>
    </Window.Resources>
    
    <Grid Name="GridMain">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="3*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height=".5*"/>
            <RowDefinition Height="9*"/>
        </Grid.RowDefinitions>
        
        <!-- Grid Left -->
        <Grid x:Name="GridLeft" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="300"/>
                <RowDefinition Height="300"/>
                <RowDefinition Height="480"/>
            </Grid.RowDefinitions>
        </Grid>

        <!-- Grid Middle -->
        <Grid x:Name="GridMiddle" Grid.Column="1">
            
        </Grid>

        <!-- Grid Right -->
        <Grid x:Name="GridRight" Grid.Column="2">
            
        </Grid>
        
        <busyIndicator:BusyMask Grid.RowSpan="3" Width="1920" Height="1080" Visibility="Visible"
        x:Name="BusyIndicator"
        BusyContent="검사를 종료하고 있습니다. 서버 연결 상태에 따라 시간이 소요될 수 있습니다."
        IndicatorType="Ring"
        IsBusy="False"
        Background="#D8FFFFFF" Grid.ColumnSpan="3" Margin="0,0,0,-16"/>
    </Grid>
</Window>
