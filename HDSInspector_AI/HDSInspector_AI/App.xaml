<Application x:Class="HDSInspector_AI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HDSInspector_AI"
             xmlns:hc="http://handyorg.github.io/handycontrol">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>

                <!-- MahApps 기본 스타일 -->
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />

                <!-- HDS Control styles-->
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/ButtonStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/ScrollBarStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/ListBoxStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/TextBoxStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/ToggleButtonStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/SimpleStyle.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/PieDataPoint.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/Common;component/ControlStyles/TabStyle.xaml"/>
                
                <ResourceDictionary Source="pack://application:,,,/BusyIndicator;component/Theme/Default.xaml"/>

            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
